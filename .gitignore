# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Curriculum corpus — the fetched PDFs are large binaries (100 MB+ already, and
# every added exam year grows it). manifest.json and scripts/fetch-curriculum.mjs
# are committed instead, so the whole tree rebuilds with `npm run curriculum:fetch`.
/src/curriculum/**/*.pdf
